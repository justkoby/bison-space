# ——— Bison's Space content dashboard — environment variables ———
# Copy to `.env.local` (git-ignored) for local dev. Only VITE_* vars reach the browser.
#
# ⚠️ NEVER prefix the service-role key with VITE_ and never import it in src/.
#    It bypasses Row Level Security and is for server-side scripts only
#    (seeding, creating the first admin account). Keep it out of the bundle.

# ——— Browser (safe to expose) ———
# Supabase project URL and anon/public key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public-site content source:
#   static    → (default) the site renders the checked-in src/content/*.ts modules.
#               Use this until the Supabase migration is verified.
#   supabase  → the public site reads published content from Supabase, falling
#               back to the static modules on any error.
VITE_CONTENT_SOURCE=static

# ——— Server-side only (Node scripts; NOT exposed to the browser) ———
# Used by scripts/*-supabase.mjs and the seed/admin-provisioning steps.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Credentials for the verification script's "authorized write" path (optional).
# Create this admin via the setup guide before running scripts/verify-supabase.mjs.
BS_ADMIN_EMAIL=
BS_ADMIN_PASSWORD=
